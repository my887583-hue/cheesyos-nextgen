{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "paths": {
      "@cheesyos/nextgen-shared": ["../packages/shared/src/index.ts"],
      "@cheesyos/pos-core": ["../packages/pos-core/src/index.ts"],
      "@cheesyos/pos-local": ["../packages/pos-local/src/index.ts"],
      "@cheesyos/pos-sync": ["../packages/pos-sync/src/index.ts"]
    },

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../packages/pos-local/src/node-sqlite.d.ts"]
}
